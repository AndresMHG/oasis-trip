# Copie este arquivo para ".env" (nunca envie o .env para o GitHub — ele já está no .gitignore)

# Senha de acesso ao painel /admin (mínimo 8 caracteres; em produção é obrigatória)
NUXT_ADMIN_PASSWORD=troque-esta-senha

# Texto longo e aleatório (mínimo 32 caracteres) que protege o login
NUXT_SESSION_SECRET=coloque-aqui-um-texto-bem-longo-e-aleatorio-com-32-ou-mais-caracteres

# Banco de dados Neon (Postgres). Na Vercel é criado sozinho ao conectar o Neon em "Storage".
# Sem esta variável, no computador os dados ficam em arquivos na pasta .data/db
DATABASE_URL=
